  "productName": "Vaulti",
  "identifier": "net.fenixs.vaulti",
  "version": "0.1.0",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
